<Window x:Class="CircuitDesigner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Circuit Design Simulator" Width="960" Height="640" Background="#0B1220" Foreground="#F4F7FF"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="CIRCUIT DESIGN STUDIO" Foreground="#70C8FF" FontWeight="Bold"/><TextBlock Text="DC Circuit Builder" FontSize="32" FontWeight="Bold" Margin="0,5,0,15"/></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,15"><ComboBox x:Name="PartType" Width="110" SelectedIndex="0"><ComboBoxItem Content="Resistor"/><ComboBoxItem Content="Voltage"/></ComboBox><TextBox x:Name="NameBox" Width="110" Text="R1" Margin="7,0"/><TextBox x:Name="NodeA" Width="80" Text="1"/><TextBox x:Name="NodeB" Width="80" Text="0" Margin="7,0"/><TextBox x:Name="ValueBox" Width="110" Text="1000"/><Button Content="Add Element" Click="Add_Click" Padding="14,8" Margin="8,0"/><Button Content="Export Netlist" Click="Export_Click" Padding="14,8"/><Button Content="Solve" Click="Solve_Click" Padding="14,8" Margin="8,0"/></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#152136" CornerRadius="10" Padding="12" Margin="0,0,10,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Circuit components" FontWeight="Bold"/><ListBox x:Name="Parts" Background="#152136" Foreground="White" BorderThickness="0" FontFamily="Consolas"/></DockPanel></Border><Border Grid.Column="1" Background="#152136" CornerRadius="10" Padding="12"><DockPanel><TextBlock Text="Solver output" DockPanel.Dock="Top" FontWeight="Bold"/><TextBox x:Name="Output" Background="#152136" Foreground="White" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></DockPanel></Border></Grid>
</Grid></Window>